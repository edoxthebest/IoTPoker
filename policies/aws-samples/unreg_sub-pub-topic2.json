{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["iot:Connect"],
      "Resource": [
        "arn:aws:iot:us-east-1:123456789012:client/clientId4",
        "arn:aws:iot:us-east-1:123456789012:client/clientId5",
        "arn:aws:iot:us-east-1:123456789012:client/clientId6"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["iot:Publish"],
      "Resource": [
        "arn:aws:iot:us-east-1:123456789012:topic/some_specific_topic"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["iot:Subscribe"],
      "Resource": [
        "arn:aws:iot:us-east-1:123456789012:topicfilter/some_specific_topic"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["iot:Receive"],
      "Resource": [
        "arn:aws:iot:us-east-1:123456789012:topic/some_specific_topic"
      ]
    }
  ]
}
